# Copy this file to .env.local for local development,
# and add the same value in your hosting panel's environment variables for production.

# Resend API key — the contact form uses this to email every inquiry straight to
# info@taxi-werbung.org. Get a free key at https://resend.com (sign up, then
# Dashboard > API Keys > Create API Key).
#
# Free tier is enough for a contact form (100 emails/day, 3,000/month).
#
# IMPORTANT: until you verify your own domain in Resend (Dashboard > Domains >
# Add Domain, then add the DNS records they give you at your DNS provider),
# emails are sent from Resend's shared test address, which works fine but looks
# less professional. Once taxi-werbung.org is verified, update the "from" address
# in app/api/lead/route.ts to something like "Taxi-Werbung.org <info@taxi-werbung.org>".
RESEND_API_KEY=
